<Window x:Class="HateVPN.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HateVPN — установка" Icon="pack://application:,,,/HateVPN.Setup;component/Assets/HateVPN.ico"
        Width="760" Height="520" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI Variable Display, Segoe UI" Foreground="#EDF2F4" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="48" /><Setter Property="Background" Value="#EDF2F4" />
            <Setter Property="Foreground" Value="#11191D" /><Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="11">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#FFFFFF" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".72" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".45" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="#1B252A" /><Setter Property="Foreground" Value="#DCE5E9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="#43525A" BorderThickness="1" CornerRadius="9" Padding="10,5">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#2A363D" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".7" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".45" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="OptionCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D8E2E6" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Border x:Name="Box" Width="19" Height="19" CornerRadius="5" Background="#1B252A" BorderBrush="#687982" BorderThickness="1" VerticalAlignment="Center">
                        <TextBlock x:Name="Tick" Text="✓" FontSize="14" FontWeight="Bold" Foreground="#0D1519" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                    </Border>
                    <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#E4ECEF" /><Setter TargetName="Box" Property="BorderBrush" Value="#E4ECEF" /><Setter TargetName="Tick" Property="Visibility" Value="Visible" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".5" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="18" BorderThickness="1" BorderBrush="#3B484F" Background="#0B1013">
        <Grid ClipToBounds="True">
            <Grid.Clip><RectangleGeometry Rect="0,0,760,520" RadiusX="18" RadiusY="18" /></Grid.Clip>
            <Grid.RowDefinitions><RowDefinition Height="49" /><RowDefinition /><RowDefinition Height="58" /></Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="#11191D" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="45" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="19,0,0,0">
                    <TextBlock Text="H" FontSize="21" FontWeight="Black" FontStyle="Italic" Foreground="#F2F5F6" VerticalAlignment="Center" Margin="0,0,11,0" />
                    <TextBlock Text="HateVPN" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="   /   УСТАНОВКА" FontSize="10" FontWeight="SemiBold" Foreground="#90A2AB" VerticalAlignment="Center" />
                </StackPanel>
                <Button x:Name="CloseButton" Grid.Column="1" Content="×" FontSize="20" Style="{StaticResource GhostButton}" Width="30" Height="30" VerticalAlignment="Center" HorizontalAlignment="Center" Click="Close_Click" IsCancel="True" AutomationProperties.Name="Закрыть установщик" />
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="246" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Grid Grid.Column="0" ClipToBounds="True">
                    <Image Source="pack://application:,,,/HateVPN.Setup;component/Assets/installer-background.png" Stretch="UniformToFill" Width="455" HorizontalAlignment="Left" IsHitTestVisible="False" />
                    <MediaElement x:Name="InstallerVideo" Stretch="UniformToFill" LoadedBehavior="Manual" UnloadedBehavior="Manual" IsHitTestVisible="False" MediaOpened="Video_MediaOpened" MediaEnded="Video_MediaEnded" MediaFailed="Video_MediaFailed" />
                    <Rectangle Fill="#460B1115" IsHitTestVisible="False" />
                    <Rectangle IsHitTestVisible="False"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#0010161A" Offset="0" /><GradientStop Color="#ED0A1014" Offset="1" /></LinearGradientBrush></Rectangle.Fill></Rectangle>
                    <StackPanel VerticalAlignment="Bottom" Margin="23,0,18,24">
                        <TextBlock Text="HateVPN" FontSize="27" FontWeight="SemiBold" />
                        <TextBlock Text="by DarkSide" FontSize="12" Foreground="#CBD5D9" Margin="1,2,0,0" />
                        <Border Background="#BECBD0" Width="35" Height="2" HorizontalAlignment="Left" Margin="1,18,0,11" />
                        <TextBlock Text="Личный VPN. Всё нужное — внутри." FontSize="12" Foreground="#C8D3D8" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Column="1" Margin="28,25,30,23">
                    <Grid x:Name="SetupPanel">
                        <StackPanel VerticalAlignment="Top">
                            <TextBlock Text="БЫСТРЫЙ СТАРТ" FontSize="10" FontWeight="SemiBold" Foreground="#91A8B2" />
                            <TextBlock Text="Установить HateVPN" FontSize="27" FontWeight="SemiBold" Margin="0,9,0,0" />
                            <TextBlock Text="Выберите папку и нажмите «Установить»." Foreground="#ADBDC5" FontSize="12" Margin="0,6,0,0" />
                            <TextBlock Text="ПАПКА УСТАНОВКИ" Foreground="#98AAB3" FontSize="10" FontWeight="SemiBold" Margin="0,26,0,8" />
                            <Border Background="#1A2429" BorderBrush="#4E5D65" BorderThickness="1" CornerRadius="10" Height="46">
                                <Grid Margin="10,0,6,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="82" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="InstallPathBox" Background="Transparent" BorderThickness="0" Foreground="#EDF2F4" CaretBrush="White" VerticalContentAlignment="Center" FontSize="12" AutomationProperties.Name="Папка установки" />
                                    <Button x:Name="BrowseInstallPathButton" Grid.Column="1" Content="Изменить" Height="31" Style="{StaticResource GhostButton}" Click="BrowseInstallPath_Click" AutomationProperties.Name="Выбрать папку установки" />
                                </Grid>
                            </Border>
                            <CheckBox x:Name="DesktopShortcutCheck" IsChecked="True" Style="{StaticResource OptionCheck}" Margin="1,20,0,0" AutomationProperties.Name="Создать ярлык на рабочем столе">
                                <TextBlock Text="Ярлык на рабочем столе" FontSize="13" />
                            </CheckBox>
                            <TextBlock Text="Удалить программу можно будет через меню «Пуск»." Foreground="#8FA2AB" FontSize="11" Margin="1,15,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Bottom">
                            <TextBlock x:Name="StatusText" MinHeight="16" Foreground="#F1B0B0" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <Button x:Name="InstallButton" Content="Установить" Style="{StaticResource PrimaryButton}" Click="Install_Click" IsDefault="True" AutomationProperties.Name="Установить HateVPN" />
                            <TextBlock Text="Windows запросит разрешение на установку службы VPN." Foreground="#8FA2AB" FontSize="10" Margin="0,9,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="InstallingPanel" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="УСТАНОВКА" FontSize="10" FontWeight="SemiBold" Foreground="#91A8B2" />
                            <TextBlock Text="Идёт установка" FontSize="29" FontWeight="SemiBold" Margin="0,11,0,0" />
                            <TextBlock x:Name="InstallStageText" Text="Подготавливаем файлы…" Foreground="#B8C7CE" FontSize="13" Margin="0,10,0,0" />
                            <ProgressBar x:Name="InstallProgress" IsIndeterminate="True" Height="5" Foreground="#E5ECEF" Background="#28343A" Margin="0,29,0,0" />
                            <TextBlock Text="Пожалуйста, дождитесь завершения установки." Foreground="#8FA2AB" FontSize="11" Margin="0,14,0,0" />
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="SuccessPanel" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center">
                            <Border Width="52" Height="52" CornerRadius="16" Background="#263B33" BorderBrush="#6B8A75" BorderThickness="1" HorizontalAlignment="Left">
                                <TextBlock Text="✓" FontSize="29" FontWeight="SemiBold" Foreground="#DAF0DF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Всё готово" FontSize="30" FontWeight="SemiBold" Margin="0,17,0,0" />
                            <TextBlock Text="HateVPN установлен." FontSize="17" Foreground="#DCE5E9" Margin="0,5,0,0" />
                            <TextBlock Text="Спасибо, что выбрали HateVPN. Теперь можно подключить подписку или свой сервер." Foreground="#ACBDC5" FontSize="12" TextWrapping="Wrap" Margin="0,15,0,0" />
                            <TextBlock x:Name="RestartText" Text="Для завершения потребуется перезагрузка Windows." Foreground="#D8C9A4" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,11,0,0" />
                            <Button x:Name="OpenButton" Content="Открыть HateVPN" Style="{StaticResource PrimaryButton}" Margin="0,27,0,0" Click="Open_Click" IsDefault="True" AutomationProperties.Name="Открыть HateVPN" />
                            <Button Content="Закрыть установщик" Style="{StaticResource GhostButton}" Height="40" Margin="0,9,0,0" Click="Close_Click" />
                            <TextBlock x:Name="OpenErrorText" Foreground="#F1B0B0" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <Grid Grid.Row="2" Background="#121A1E">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="92" /><ColumnDefinition Width="82" /><ColumnDefinition Width="148" /><ColumnDefinition Width="45" /></Grid.ColumnDefinitions>
                <TextBlock Text="▶   Видео со звуком" Foreground="#C1CDD2" VerticalAlignment="Center" FontSize="11" Margin="21,0,0,0" />
                <Button x:Name="VideoButton" Grid.Column="1" Content="Пауза" Width="76" Height="30" Style="{StaticResource GhostButton}" Click="Video_Click" AutomationProperties.Name="Остановить или включить видео" />
                <TextBlock Grid.Column="2" Text="Громкость" Foreground="#9BABB3" VerticalAlignment="Center" FontSize="10" HorizontalAlignment="Right" Margin="0,0,9,0" />
                <Slider x:Name="VolumeSlider" Grid.Column="3" Width="132" Minimum="0" Maximum="100" Value="12" VerticalAlignment="Center" ValueChanged="Volume_Changed" ToolTip="Громкость видео" AutomationProperties.Name="Громкость видео" />
                <TextBlock x:Name="VolumeValue" Grid.Column="4" Text="12%" Foreground="#C1CDD2" VerticalAlignment="Center" FontSize="10" Margin="1,0,0,0" />
            </Grid>
        </Grid>
    </Border>
</Window>
